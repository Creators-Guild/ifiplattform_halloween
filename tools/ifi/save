#!/usr/bin/env bash
# ifi save "message": saves (commits) every change in the whole repo, not
# just the folder you're in: `git add .` in ifiplatform/ misses changes in
# docs/ or tools/. Shows the files first, and asks for your name and email
# the first time.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/common.sh"

branch="$(git branch --show-current)"
[[ -n "$branch" ]] || die "You're not on a branch. Start one with: ifi fix-issue <nr>"
[[ "$branch" != main ]] || die "You're on main. Make a branch for your issue first, your" \
    "changes come along to it: ifi fix-issue <nr>"

cd "$(git rev-parse --show-toplevel)"
[[ -n "$(git status --porcelain)" ]] || die "Nothing to save: you have no changes since your last save."

message="$*"
while [[ -z "${message// /}" ]]; do
    read -r -p "Short description of what you changed: " message || die ""
done

ensure_identity
run git add -A
echo "Saving these files:"
git diff --cached --name-status | sed -E 's/^A\t/  new      /; s/^M\t/  changed  /; s/^D\t/  deleted  /; s/^R[0-9]*\t/  renamed  /; s/^[A-Z][0-9]*\t/  changed  /'
run git commit --quiet -m "$message"

cat <<EOF

Saved. Next:
  ifi pull-request    send it to GitHub (also to update a pull request you already made)
Wrong file in there? ifi undo-file <file>, after ifi pull-request.
EOF
