# Django - the placeholder is fine for local development. Servers need a real random key (see docs/contributing/setup_without_docker.md).
DJANGO_SECRET_KEY=your-secret-key-here

# No need to change this while you are just working on a development server
DEBUG=True

DEEPL_API_KEY=your-secret-key-here # ignore if you have no api key

# Set after running `manage.py sync_deepl_glossary` (see that command and
# ifi_home_app/deepl_glossary_terms.py) -- makes DeepL respect fixed
# nb -> en translations for words it otherwise guesses wrong. Leave blank
# to just use DeepL's plain translation.
DEEPL_GLOSSARY_ID=

# Local Database (PostgreSQL), these are only useful if you are running the
# database locally, else ignore
DB_NAME=ifiplatform
DB_USER=ifiplatform_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# Set to True to use the Postgres settings above even while DEBUG=True
# (e.g. testing against a local Postgres container without also enabling
# the DEBUG=False security settings, which need real HTTPS to work).
# Leave False to just use the normal local SQLite file.
USE_POSTGRES=False

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Email (account verification) - leave EMAIL_HOST blank to just print emails
# to the console instead of sending them (fine for local dev)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ifiplattform.no

# --- Analytics (optional) ---
# Self-hosted Umami. Leave empty in development: tracking is disabled when unset.
# Production values live only in the server's .env.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
