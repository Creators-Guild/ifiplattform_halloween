#!/usr/bin/env bash
# ifi reset-database: deletes the local database and fills it again with the
# starter content, like `docker compose down -v` but from inside the
# container, and without deleting the Claude Code login volume. It empties
# PostgreSQL's public schema instead of deleting the database, so the db
# container keeps running. The start-up steps are the same as in
# docker-compose.yml's command. Uploaded media files are kept.
# Without Docker it deletes the SQLite file (ifiplatform/db.sqlite3) instead.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/common.sh"
here="$(dirname "$(readlink -f "$0")")"

find_django_python

cat <<'TXT'
This DELETES your local database: every page, article and login you made on
http://localhost:8000. Then it fills it again with the starter content.
Your code and Git branches are not touched.
TXT
read -r -p "Type yes to reset: " answer || answer=""
[[ "$answer" == yes ]] || die "Nothing was deleted."

cd "$(git rev-parse --show-toplevel)/ifiplatform"
if in_container; then
    run "Empty the database" "$DJANGO_PY" manage.py shell -c "from django.db import connection; connection.cursor().execute('DROP SCHEMA public CASCADE; CREATE SCHEMA public;')"
else
    echo "Stop the server first (Ctrl+C in its terminal), or Windows won't let the file be deleted."
    read -r -p "Press Enter when it's stopped. " _ || true
    run "Delete the database file" rm -f db.sqlite3
fi
run "Make all the tables again" "$DJANGO_PY" manage.py migrate
in_container && run "Make the cache table again" "$DJANGO_PY" manage.py createcachetable
run "Fill in the starter content" "$DJANGO_PY" manage.py seed_dev_data
"$here/restart-server"
echo "Reset done. Log in with admin / admin (made by seed_dev_data)."
