#!/usr/bin/env bash
# `ifi`: this project's own helper commands. Dockerfile.dev
# links it into the dev container's PATH; without Docker, `ifi install` adds
# the launcher in the repo root (../../ifi) to your terminal.
# Every subcommand is a script next to this one. Tests: tests/run, and
# tests/playground to try them by hand.
set -euo pipefail

here="$(dirname "$(readlink -f "$0")")"
cmd="${1:-help}"
shift || true

case "$cmd" in
    help | -h | --help) exec "$here/help" "$@" ;;
    fix-issue | save | check | update | pull-request | undo-file | cleanup | account | install | test | migrate | restart-server | reset-database | rebuild-docker) exec "$here/$cmd" "$@" ;;
    *)
        echo "ifi: no command called '$cmd'. Type: ifi help" >&2
        exit 1
        ;;
esac
