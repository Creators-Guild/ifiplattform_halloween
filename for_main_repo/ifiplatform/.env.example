# Copy this file to .env (in this folder) and fill in what you need.
#
# Two parts:
# 1. Used everywhere: keys and options for extra features. All optional for
#    local development; the site runs without them.
# 2. Only without Docker. The Docker dev container sets these itself (in
#    docker-compose.yml), and a setting it sets always wins over this file,
#    so in Docker the lines in part 2 do nothing. You can delete them.


# ===== 1. Used everywhere ===================================================

# DeepL, for the translation tools. Leave empty if you have no key.
DEEPL_API_KEY=
# Set after running `manage.py sync_deepl_glossary` (see that command and
# ifi_home_app/translation/glossary_terms.py) -- makes DeepL respect fixed
# nb -> en translations for words it otherwise guesses wrong. Leave blank
# to just use DeepL's plain translation.
DEEPL_GLOSSARY_ID=

# Email (account verification). Leave EMAIL_HOST blank to just print emails
# to the console instead of sending them (fine for local dev).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ifiplattform.no

# Extra origins allowed to post forms (comma-separated). Leave empty locally.
CSRF_TRUSTED_ORIGINS=

# Self-hosted Umami analytics. Leave empty in development: tracking is
# disabled when unset. Production values live only in the server's .env.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=


# ===== 2. Only without Docker ===============================================
# docker-compose.yml sets all of these for the dev container.

# Django - the placeholder is fine for local development. Servers need a real
# random key (see docs/contributing/setup_without_docker.md).
DJANGO_SECRET_KEY=your-secret-key-here

# No need to change this while you are just working on a development server
DEBUG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to True to use the Postgres settings below even while DEBUG=True
# (e.g. testing against a local Postgres container without also enabling
# the DEBUG=False security settings, which need real HTTPS to work).
# Leave False to just use the normal local SQLite file.
USE_POSTGRES=False

# Local database (PostgreSQL). Only used with USE_POSTGRES=True or
# DEBUG=False; otherwise ignore.
DB_NAME=ifiplatform
DB_USER=ifiplatform_user
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432
