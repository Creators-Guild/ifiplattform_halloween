# Settings for one Docker server. Copy to .env in the repo root and fill in:
#   cp deploy/docker/.env.example .env
# .env is never committed. Guide: docs/operations/docker_server.md.
#
# Set automatically by compose.prod.yml, so don't add them here:
# USE_POSTGRES, DB_HOST, DB_PORT, DJANGO_ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS,
# FORWARDED_ALLOW_IPS. To see the final values: docker compose config

# --- Docker ---
# Lets you type `docker compose ...` on the server without -f compose.prod.yml.
COMPOSE_FILE=compose.prod.yml
# The git branch this server runs.
DEPLOY_BRANCH=main

# --- The site ---
# The address the site is served at, without https://. Caddy gets the HTTPS
# certificate for it, and Django only answers requests for it.
SITE_DOMAIN=halloween.ifiplattform.no
# "noindex, nofollow" hides the site from search engines. Use "all" on the real site.
ROBOTS_TAG=noindex, nofollow

# --- Django ---
# A long random value, different on every server. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Always False on a server.
DEBUG=False

# --- Database ---
DB_NAME=ifiplatform
DB_USER=ifiplatform_user
# PostgreSQL only reads this the first time it creates the database.
# Changing it here later does NOT change the database's password, and
# Django then can't log in. Change it inside the database too:
#   docker compose exec db psql -U <DB_USER> -d <DB_NAME> -c "ALTER USER <DB_USER> PASSWORD '<new>';"
DB_PASSWORD=

# --- Fake content ---
# A management command deploy.sh runs after every migrate, to fill the site
# with fake content. It must skip what already exists. Leave empty on the
# real site.
SEED_COMMAND=

# --- Optional services (leave empty on the mock site) ---
DEEPL_API_KEY=
DEEPL_GLOSSARY_ID=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@ifiplattform.no

UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
