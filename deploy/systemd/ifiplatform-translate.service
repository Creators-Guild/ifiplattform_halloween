[Unit]
Description=Translate pages/snippets waiting for English with DeepL
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/IfiPlatform/ifiplatform
ExecStart=/home/ubuntu/IfiPlatform/venv/bin/python manage.py translate_english
